{
  "name": "miu-world",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx tools/dev/start-dev-servers.ts",
    "assets:fetch": "tsx tools/assets/fetch-assets.ts",
    "assets:manifest": "tsx tools/assets/build-manifest.ts",
    "assets:check": "tsx tools/assets/check-assets.ts",
    "content:check": "tsx tools/content/check-content.ts",
    "content:gaps": "tsx tools/content/content-gaps.ts",
    "sgk:review": "tsx tools/sgk/review-quests.ts",
    "sgk:acceptance": "tsx tools/sgk/acceptance-page.ts",
    "private:sync": "tsx tools/private/sync-private.ts",
    "private:check": "tsx tools/private/sync-private.ts --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "assets:character": "tsx tools/assets/kitbash-character.ts",
    "assets:preview": "tsx tools/assets/render-preview.ts",
    "assets:home": "tsx tools/assets/render-home-island.ts",
    "assets:regions": "tsx tools/assets/render-region-art.ts",
    "assets:pets": "tsx tools/assets/render-pet-art.ts",
    "security:dist": "tsx tools/security/scan-dist.ts",
    "assets:atlas": "tsx tools/assets/build-atlas.ts",
    "assets:sounds": "tsx tools/assets/build-sounds.ts",
    "assets:props": "tsx tools/assets/build-emoji-props.ts",
    "assets:box-props": "tsx tools/assets/build-box-props.ts",
    "world:forest": "tsx tools/world/generate-forest-map.ts",
    "world:school": "tsx tools/world/generate-school-map.ts",
    "world:overview": "tsx tools/world/generate-world-overview.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/picomatch": "^4.0.3",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.11.0",
    "fflate": "^0.8.3",
    "gl-matrix": "^3.4.4",
    "picomatch": "^4.0.7",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zod": "^4.6.5",
    "eslint-plugin-react-hooks": "^7.1.1"
  }
}
