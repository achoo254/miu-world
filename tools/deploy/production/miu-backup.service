[Unit]
Description=Miu World production database backup (daily dump, 14 days kept; bots' learning, 90 days kept)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
# Custom-format dump (restore: see docs/deployment-guide.md). /privacy promises that deleted data is
# gone from backups within 14 days: keep the 14 newest daily files, and drop any dump (daily or the
# before-<release> ones) older than that.
ExecStart=/bin/sh -c 'pg_dump -Fc miu > /var/backups/miu/daily-$(date +%%Y%%m%%d).dump && ls -1t /var/backups/miu/daily-*.dump | tail -n +15 | xargs -r rm -f && find /var/backups/miu -maxdepth 1 -name "*.dump" -mtime +13 -delete'
# What the companion bots learnt (their own skill XP and memories of the maps: no player id, nothing
# about a player) also goes on its own for 90 days in bots/, out of reach of the 14-day rule above, so a
# loss found late can still be undone. Never add a table with player data here (/privacy, 14 days).
ExecStart=/bin/sh -c 'pg_dump -Fc -t bot_world_memories -t bot_skills miu > /var/backups/miu/bots/bots-$(date +%%Y%%m%%d).dump && ls -1t /var/backups/miu/bots/bots-*.dump | tail -n +91 | xargs -r rm -f && find /var/backups/miu/bots -maxdepth 1 -name "bots-*.dump" -mtime +89 -delete'
