[Unit]
Description=Miu World production database backup (daily dump, 14 kept)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
# Custom-format dump (restore: see docs/deployment-guide.md); keep the 14 newest daily files.
ExecStart=/bin/sh -c 'pg_dump -Fc miu > /var/backups/miu/daily-$(date +%%Y%%m%%d).dump && ls -1t /var/backups/miu/daily-*.dump | tail -n +15 | xargs -r rm -f'
