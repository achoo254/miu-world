{
  "name": "@miu/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:release": "tsc --noEmit -p tsconfig.json && vite build --mode release",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "playwright test",
    "e2e:ci": "playwright test -c playwright.ci.config.ts",
    "e2e:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "@miu/schema": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5",
    "@miu/quest": "workspace:*",
    "@miu/voxel": "workspace:*",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "vite": "^8.3.1",
    "@types/three": "^0.186.0",
    "@playwright/test": "^1.63.0"
  }
}
