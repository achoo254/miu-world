{
  "name": "@miu/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:release": "tsc --noEmit -p tsconfig.json && vite build --mode release",
    "build:native": "vite build --mode native",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "playwright test",
    "e2e:ci": "playwright test -c playwright.ci.config.ts",
    "e2e:smoke": "playwright test -c playwright.ci.config.ts",
    "screens": "playwright test --project setup --project screens",
    "store:screens": "playwright test --project store"
  },
  "dependencies": {
    "@shared-next/brand": "github:achoo254/shared-next#v0.2.0&path:/packages/brand",
    "@miu/schema": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.7",
    "@miu/quest": "workspace:*",
    "@miu/voxel": "workspace:*",
    "three": "^0.186.1",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@shared-next/capacitor-system-auth": "github:achoo254/shared-next#v0.3.0&path:/packages/capacitor-system-auth"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "vite": "^8.3.1",
    "@types/three": "^0.186.0",
    "@playwright/test": "^1.63.0"
  }
}
