{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "vite.config.ts",
    "vite-repo-assets.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.ci.config.ts",
    "../../packages/schema/src/**/*.ts",
    "../../packages/quest/src/**/*.ts",
    "../../packages/voxel/src/**/*.ts"
  ]
}
